 SNAME                                     NOT NULL VARCHAR2(20)
 AGE                                                NUMBER(2)
 SUBNAME                                            VARCHAR2(10)
 PHONE_NO                                           NUMBER(10)

SQL>  RENAME STUDENT TO STUD;

