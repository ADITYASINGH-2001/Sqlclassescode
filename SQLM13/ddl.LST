SQL> CREATE TABLE BOOK
  2  (
  3  BID NUMBER(4) PRIMARY KEY CHECK(BID>0) CHECK(LENGTH(BID)=4),
  4  BNAME VARCHAR(20),
  5  PRICE NUMBER(4),
  6  SID NUMBER(4));

Table created.

SQL> ALTER TABLE BOOK
  2  ADD CONSTRAINTS FK_SID FOREIGN KEY(SID) REFERENCES STUD(SID);

