SQL> CREATE TABLE STUDENT
  2  (SID NUMBER(4) PRIMARY KEY CHECK(LENGTH(SID)=4) CHECK(SID>0),
  3  SNAME VARCHAR(20) NOT NULL,
  4  AGE NUMBER(2),
  5  SUBNAME VARCHAR(10),
  6  PHONE_NO NUMBER(10) CHECK(PHONE_NO>0) CHECK(LENGTH(PHONE_NO)=10)
  7  );

Table created.

